generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MERCHANT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  FINANCE
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  SHIFT_PAYMENT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum AccountingAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
}

enum AccountingJournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountingDimensionType {
  BRANCH
  COST_CENTER
  PROJECT
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum OpenBalanceType {
  RECEIVABLE
  PAYABLE
}

enum OpenBalanceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

enum CatalogItemType {
  STOCK_ITEM
  SERVICE
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum ChequeRecordDirection {
  RECEIVED
  ISSUED
}

enum ChequeRecordStatus {
  REGISTERED
  DUE
  CLEARED
  BOUNCED
  CANCELLED
}

enum ReconciliationRecordStatus {
  PENDING
  MATCHED
  REJECTED
}

enum SalesStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  PAID
  CANCELLED
}

enum RecoveryChannel {
  PHONE
  EMAIL
}

model User {
  id                 String                    @id @default(uuid())
  name               String?
  email              String?                   @unique
  emailVerified      Boolean                   @default(false)
  image              String?
  phone              String?                   @unique
  legacyPassword     String?                   @map("password")
  role               Role                      @default(MERCHANT)
  merchant           Merchant?
  sessions           Session[]
  accounts           Account[]
  memberships        Membership[]
  recoveryChallenges LegacyRecoveryChallenge[]
  recoveryGrants     LegacyRecoveryGrant[]
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model LegacyRecoveryChallenge {
  id              String          @id
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel         RecoveryChannel
  destinationHint String
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId, expiresAt])
}

model LegacyRecoveryGrant {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  issuedAt   DateTime
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt, consumedAt])
}

model Workspace {
  id                   String                          @id @default(uuid())
  name                 String
  slug                 String                          @unique
  memberships          Membership[]
  accountingAccounts   AccountingAccount[]
  fiscalPeriods        FiscalPeriod[]
  fiscalReopenAudits   FiscalReopenAudit[]
  accountingJournals   AccountingJournal[]
  counterparties       Counterparty[]
  openBalances         OpenBalance[]
  catalogItems         CatalogItem[]
  warehouses           Warehouse[]
  stockMovements       StockMovement[]
  purchaseInvoices     PurchaseInvoice[]
  salesInvoices        SalesInvoice[]
  chequeRecords        ChequeRecord[]
  bankEvidence         BankEvidence[]
  employees            Employee[]
  payrollRuns          PayrollRun[]
  fixedAssets          FixedAsset[]
  assetDepreciations   AssetDepreciation[]
  subscription         WorkspaceSubscription?
  apiKeys              ApiKey[]
  dimensionValues      AccountingDimensionValue[]
  dimensionAssignments AccountingDimensionAssignment[]
  auditEvents          AuditEvent[]
  financialEvidence    FinancialEvidence[]
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
}

model Membership {
  id          String           @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole    @default(VIEWER)
  status      MembershipStatus @default(ACTIVE)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
  @@index([userId, status])
}

model Merchant {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  name         String
  iban         String?
  status       String        @default("PENDING")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id           String            @id @default(uuid())
  merchantId   String
  merchant     Merchant          @relation(fields: [merchantId], references: [id])
  amount       Int
  type         TransactionType
  status       TransactionStatus @default(PENDING)
  trackingCode String?
  orderRef     String?
  targetIban   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([merchantId])
}

model Counterparty {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type             CounterpartyType
  name             String
  nationalId       String?
  economicCode     String?
  phone            String?
  email            String?
  active           Boolean           @default(true)
  openBalances     OpenBalance[]
  purchaseInvoices PurchaseInvoice[]
  salesInvoices    SalesInvoice[]
  chequeRecords    ChequeRecord[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([workspaceId, type, active])
  @@index([workspaceId, name])
}

model OpenBalance {
  id                String            @id @default(uuid())
  workspaceId       String
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  counterpartyId    String
  counterparty      Counterparty      @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  type              OpenBalanceType
  sourceDocumentId  String
  issuedAt          DateTime
  dueAt             DateTime
  originalAmount    BigInt
  outstandingAmount BigInt
  currency          String            @default("IRR")
  status            OpenBalanceStatus @default(OPEN)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([workspaceId, type, sourceDocumentId])
  @@index([workspaceId, type, status, dueAt])
  @@index([counterpartyId, status])
}

model AccountingAccount {
  id           String                  @id @default(uuid())
  workspaceId  String
  workspace    Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code         String
  name         String
  type         AccountingAccountType
  parentId     String?
  parent       AccountingAccount?      @relation("AccountingAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     AccountingAccount[]     @relation("AccountingAccountTree")
  active       Boolean                 @default(true)
  journalLines AccountingJournalLine[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, type, active])
  @@index([parentId])
}

model FiscalPeriod {
  id           String              @id @default(uuid())
  workspaceId  String
  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  startsAt     DateTime
  endsAt       DateTime
  status       FiscalPeriodStatus  @default(OPEN)
  journals     AccountingJournal[]
  reopenAudits FiscalReopenAudit[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId, startsAt, endsAt])
  @@index([workspaceId, status])
}

model FiscalReopenAudit {
  id             String             @id @default(uuid())
  workspaceId    String
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod       @relation(fields: [fiscalPeriodId], references: [id], onDelete: Cascade)
  actorId        String
  reason         String
  beforeStatus   FiscalPeriodStatus
  afterStatus    FiscalPeriodStatus
  occurredAt     DateTime
  createdAt      DateTime           @default(now())

  @@index([workspaceId, fiscalPeriodId, occurredAt])
  @@index([workspaceId, actorId, occurredAt])
}

model AccountingJournal {
  id               String                  @id @default(uuid())
  workspaceId      String
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fiscalPeriodId   String?
  fiscalPeriod     FiscalPeriod?           @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  number           String?
  occurredAt       DateTime
  description      String
  status           AccountingJournalStatus @default(DRAFT)
  sourceDocumentId String?
  reversalOfId     String?
  reversalOf       AccountingJournal?      @relation("AccountingJournalReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals        AccountingJournal[]     @relation("AccountingJournalReversal")
  idempotencyKey   String?
  postedAt         DateTime?
  reversedAt       DateTime?
  lines            AccountingJournalLine[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([workspaceId, number])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, occurredAt])
  @@index([workspaceId, status])
  @@index([sourceDocumentId])
  @@index([fiscalPeriodId])
}

model AccountingJournalLine {
  id                   String                          @id @default(uuid())
  journalId            String
  journal              AccountingJournal               @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId            String
  account              AccountingAccount               @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit                BigInt                          @default(0)
  credit               BigInt                          @default(0)
  description          String?
  dimensionAssignments AccountingDimensionAssignment[]
  createdAt            DateTime                        @default(now())

  @@index([journalId])
  @@index([accountId])
}

model CatalogItem {
  id                 String                @id @default(uuid())
  workspaceId        String
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type               CatalogItemType
  name               String
  sku                String?
  barcode            String?
  unit               String
  taxRateBasisPoints Int?
  lowStockThreshold  BigInt?
  active             Boolean               @default(true)
  movements          StockMovement[]
  purchaseLines      PurchaseInvoiceLine[]
  salesLines         SalesInvoiceLine[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@unique([workspaceId, sku])
  @@index([workspaceId, type, active])
  @@index([workspaceId, name])
}

model Warehouse {
  id               String            @id @default(uuid())
  workspaceId      String
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name             String
  code             String
  active           Boolean           @default(true)
  movements        StockMovement[]
  purchaseInvoices PurchaseInvoice[]
  salesInvoices    SalesInvoice[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, active])
}

model StockMovement {
  id                 String            @id
  workspaceId        String
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  warehouseId        String
  warehouse          Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  itemId             String
  item               CatalogItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  type               StockMovementType
  quantityMinorUnits BigInt
  occurredAt         DateTime
  reference          String?
  unitCost           BigInt?
  currency           String            @default("IRR")
  createdAt          DateTime          @default(now())

  @@index([workspaceId, occurredAt])
  @@index([warehouseId, itemId, occurredAt])
  @@index([workspaceId, reference])
}

model PurchaseInvoice {
  id              String                  @id @default(uuid())
  workspaceId     String
  workspace       Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId      String
  supplier        Counterparty            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoiceNumber   String
  status          PurchaseStatus          @default(DRAFT)
  issuedAt        DateTime
  dueAt           DateTime
  subtotal        BigInt
  discount        BigInt                  @default(0)
  tax             BigInt                  @default(0)
  total           BigInt
  currency        String                  @default("IRR")
  createdBy       String
  submittedAt     DateTime?
  submittedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  postedAt        DateTime?
  postedBy        String?
  cancelledAt     DateTime?
  cancelledBy     String?
  postedJournalId String?
  payableId       String?
  lines           PurchaseInvoiceLine[]
  statusHistory   PurchaseStatusHistory[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status, issuedAt])
  @@index([supplierId, status, dueAt])
  @@index([warehouseId, issuedAt])
}

model PurchaseInvoiceLine {
  id                 String          @id @default(uuid())
  purchaseInvoiceId  String
  purchaseInvoice    PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  itemId             String
  item               CatalogItem     @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantityMinorUnits BigInt
  unitPrice          BigInt
  discount           BigInt          @default(0)
  tax                BigInt          @default(0)
  lineTotal          BigInt
  createdAt          DateTime        @default(now())

  @@index([purchaseInvoiceId])
  @@index([itemId])
}

model PurchaseStatusHistory {
  id                String          @id @default(uuid())
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  fromStatus        PurchaseStatus?
  toStatus          PurchaseStatus
  changedBy         String
  changedAt         DateTime        @default(now())
  note              String?

  @@index([purchaseInvoiceId, changedAt])
}

model SalesInvoice {
  id              String               @id @default(uuid())
  workspaceId     String
  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Counterparty         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId     String
  warehouse       Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  invoiceNumber   String
  status          SalesStatus          @default(DRAFT)
  issuedAt        DateTime
  dueAt           DateTime
  subtotal        BigInt
  discount        BigInt               @default(0)
  tax             BigInt               @default(0)
  total           BigInt
  cogsTotal       BigInt               @default(0)
  currency        String               @default("IRR")
  createdBy       String
  submittedAt     DateTime?
  submittedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  postedAt        DateTime?
  postedBy        String?
  cancelledAt     DateTime?
  cancelledBy     String?
  postedJournalId String?
  cogsJournalId   String?
  receivableId    String?
  lines           SalesInvoiceLine[]
  statusHistory   SalesStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([workspaceId, invoiceNumber])
  @@index([workspaceId, status, issuedAt])
  @@index([customerId, status, dueAt])
  @@index([warehouseId, issuedAt])
}

model SalesInvoiceLine {
  id                 String       @id @default(uuid())
  salesInvoiceId     String
  salesInvoice       SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  itemId             String
  item               CatalogItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  quantityMinorUnits BigInt
  unitPrice          BigInt
  discount           BigInt       @default(0)
  tax                BigInt       @default(0)
  lineTotal          BigInt
  createdAt          DateTime     @default(now())

  @@index([salesInvoiceId])
  @@index([itemId])
}

model SalesStatusHistory {
  id             String       @id @default(uuid())
  salesInvoiceId String
  salesInvoice   SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Cascade)
  fromStatus     SalesStatus?
  toStatus       SalesStatus
  changedBy      String
  changedAt      DateTime     @default(now())
  note           String?

  @@index([salesInvoiceId, changedAt])
}

model ChequeRecord {
  id                  String                @id @default(uuid())
  workspaceId         String
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  counterpartyId      String
  counterparty        Counterparty          @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  direction           ChequeRecordDirection
  chequeNumber        String
  sayadId             String?
  bankName            String?
  accountReference    String?
  amount              BigInt
  currency            String                @default("IRR")
  issuedAt            DateTime
  dueAt               DateTime
  status              ChequeRecordStatus    @default(REGISTERED)
  openBalanceId       String?
  treasuryAccountCode String?
  clearedJournalId    String?
  createdBy           String
  statusChangedBy     String?
  statusChangedAt     DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([workspaceId, chequeNumber])
  @@index([workspaceId, status, dueAt])
  @@index([counterpartyId, status])
  @@index([openBalanceId])
}

model BankEvidence {
  id               String                     @id @default(uuid())
  workspaceId      String
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountCode      String
  externalRef      String
  amount           BigInt
  direction        String
  occurredAt       DateTime
  description      String?
  status           ReconciliationRecordStatus @default(PENDING)
  matchedJournalId String?
  confidenceScore  Int?
  decidedBy        String?
  decidedAt        DateTime?
  createdBy        String
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([workspaceId, accountCode, externalRef])
  @@index([workspaceId, status, occurredAt])
  @@index([matchedJournalId])
}

enum PayrollRunStatus {
  DRAFT
  FINALIZED
  PAID
}

enum FixedAssetStatus {
  ACTIVE
  DISPOSED
}

model Employee {
  id           String        @id @default(uuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employeeCode String
  name         String
  nationalId   String?
  mobile       String?
  baseSalary   BigInt        @default(0)
  active       Boolean       @default(true)
  payrollLines PayrollLine[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workspaceId, employeeCode])
  @@index([workspaceId, active, name])
}

model PayrollRun {
  id          String           @id @default(uuid())
  workspaceId String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)
  lines       PayrollLine[]
  finalizedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId, periodStart, periodEnd])
  @@index([workspaceId, status])
}

model PayrollLine {
  id           String     @id @default(uuid())
  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  grossPay     BigInt
  deductions   BigInt     @default(0)
  netPay       BigInt
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model FixedAsset {
  id                  String              @id @default(uuid())
  workspaceId         String
  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  code                String
  name                String
  acquisitionDate     DateTime
  acquisitionCost     BigInt
  residualValue       BigInt              @default(0)
  usefulLifeMonths    Int
  status              FixedAssetStatus    @default(ACTIVE)
  depreciationEntries AssetDepreciation[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId, status, acquisitionDate])
}

model AssetDepreciation {
  id          String     @id @default(uuid())
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assetId     String
  asset       FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  periodDate  DateTime
  amount      BigInt
  note        String?
  createdAt   DateTime   @default(now())

  @@unique([assetId, periodDate])
  @@index([workspaceId, periodDate])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  SEMIANNUAL
  ANNUAL
}

model WorkspaceSubscription {
  id                  String             @id @default(uuid())
  workspaceId         String             @unique
  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planCode            String             @default("AGHAZ")
  status              SubscriptionStatus @default(TRIALING)
  billingCycle        BillingCycle?
  trialStartedAt      DateTime           @default(now())
  trialEndsAt         DateTime
  currentPeriodEndsAt DateTime?
  activatedAt         DateTime?
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  prefix      String
  secretHash  String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, revokedAt])
}

model ApiAuditLog {
  id          String   @id @default(uuid())
  workspaceId String
  apiKeyId    String?
  method      String
  path        String
  statusCode  Int
  requestId   String
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([requestId])
}

model ApiRateLimitBucket {
  id              String   @id
  workspaceId     String
  apiKeyId        String
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workspaceId, apiKeyId, windowStartedAt])
  @@index([expiresAt])
}

model AccountingDimensionValue {
  id          String                          @id @default(uuid())
  workspaceId String
  workspace   Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type        AccountingDimensionType
  code        String
  name        String
  active      Boolean                         @default(true)
  allocations AccountingDimensionAllocation[]
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([workspaceId, type, code])
  @@index([workspaceId, type, active])
  @@index([workspaceId, name])
}

model AccountingDimensionAssignment {
  id            String                          @id @default(uuid())
  workspaceId   String
  workspace     Workspace                       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  journalLineId String
  journalLine   AccountingJournalLine           @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  type          AccountingDimensionType
  allocations   AccountingDimensionAllocation[]
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@unique([journalLineId, type])
  @@index([workspaceId, type])
  @@index([workspaceId, journalLineId])
}

model AccountingDimensionAllocation {
  id               String                        @id @default(uuid())
  assignmentId     String
  assignment       AccountingDimensionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  dimensionValueId String
  dimensionValue   AccountingDimensionValue      @relation(fields: [dimensionValueId], references: [id], onDelete: Restrict)
  basisPoints      Int
  createdAt        DateTime                      @default(now())

  @@unique([assignmentId, dimensionValueId])
  @@index([dimensionValueId])
}

model AuditEvent {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actorId     String
  actorRole   String?
  actorType   String    @default("USER")
  action      String
  category    String
  severity    String    @default("INFO")
  entityType  String
  entityId    String
  requestId   String?
  reason      String?
  beforeState Json?
  afterState  Json?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, actorId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, entityType, entityId, createdAt])
  @@index([requestId])
}

model FinancialEvidence {
  id               String    @id @default(uuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  category         String
  sourceEntityType String
  sourceEntityId   String
  journalId        String?
  safeFileName     String
  mimeType         String
  byteSize         Int
  sha256           String
  storageKey       String
  description      String?
  uploadedBy       String
  archivedAt       DateTime?
  archivedBy       String?
  archiveReason    String?
  createdAt        DateTime  @default(now())

  @@unique([workspaceId, sha256, storageKey])
  @@index([workspaceId, sourceEntityType, sourceEntityId, createdAt])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, journalId])
  @@index([workspaceId, archivedAt])
}
