# Canonical Better Auth callback/origin URL.
# Use the preview URL outside production and https://tasvin.ir only in production.
BETTER_AUTH_URL="http://localhost:3000"
# Runtime connection through the Supabase transaction pooler.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct or session connection for Prisma CLI and migrations.
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Financial writes are fail-closed. Enable only in an authorized non-production environment
# after applying the reviewed schema and seeding the required chart of accounts/fiscal period.
FINANCIAL_WRITES_ENABLED="false"

# Production has a second independent gate. Keep false until explicit launch authorization
# and production evidence (backup/restore, credential inventory, migration rehearsal) are complete.
FINANCIAL_WRITES_PRODUCTION_APPROVED="false"
